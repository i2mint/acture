{
  "name": "acture-a11y",
  "version": "0.0.0",
  "description": "acture accessibility projections: ARIA props and aria-keyshortcuts from a CommandRecord, and a polite live-region announcer for dispatch results (WCAG 4.1.3).",
  "license": "Apache-2.0",
  "author": "Thor Whalen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/i2mint/acture.git",
    "directory": "packages/a11y"
  },
  "homepage": "https://github.com/i2mint/acture#readme",
  "bugs": "https://github.com/i2mint/acture/issues",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "peerDependencies": {
    "acture": "^1.0.0"
  },
  "devDependencies": {
    "acture": "workspace:*",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0",
    "zod": "^4.0.0",
    "jsdom": "^25.0.0"
  },
  "keywords": [
    "acture",
    "accessibility",
    "a11y",
    "aria",
    "wcag",
    "command-dispatch"
  ],
  "publishConfig": {
    "access": "public"
  }
}
